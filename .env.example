# Raíz del lago: carpeta local (por defecto ./data/lake), s3://bucket o gs://bucket
LAKE_ROOT=./data/lake
# Output de dbt/profiles.yml: local | aws | gcp
DBT_TARGET=local

# Solo para DBT_TARGET=gcp (en Cloud Run vienen de Secret Manager)
# GCS_HMAC_KEY_ID=
# GCS_HMAC_SECRET=

# Solo para DBT_TARGET=aws fuera de Lambda: usa tu perfil/credenciales de AWS CLI
# AWS_REGION=us-east-1
